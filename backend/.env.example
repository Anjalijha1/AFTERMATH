AFTERMATH_DB_PATH=./data/aftermath.db
AFTERMATH_CORS_ORIGINS=http://localhost:5173
# Optional. If set, all routes except /health require X-API-Key.
AFTERMATH_API_KEY=
# mock (default) or live (agent + real ArmorIQ authorization).
AFTERMATH_RUNNER=mock
# Required for AFTERMATH_RUNNER=live. Never commit real values.
ARMORIQ_API_KEY=
# Optional for live mode; without it the agent uses its deterministic fallback.
GEMINI_API_KEY=
# AFTERMATH_REFUND_LIMIT_MINOR=100000
# AFTERMATH_ARMORIQ_CONFIG=../armoriq.yaml
