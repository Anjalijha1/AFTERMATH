# Copy to .env and fill locally. .env is gitignored - never commit real keys.

# Gemini (Google AI Studio) key for the agent's LLM proposals.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ArmorIQ platform key for the live governance check.
ARMORIQ_API_KEY=

# mock (default, no keys needed) or live (agent + real ArmorIQ).
AFTERMATH_RUNNER=mock

# Optional overrides:
# GEMINI_MODEL=gemini-2.5-flash
# AFTERMATH_REFUND_LIMIT_MINOR=100000
# AFTERMATH_ARMORIQ_CONFIG=./armoriq.yaml
# AFTERMATH_ARMORIQ_MCP_ID=aftermath-mcp
